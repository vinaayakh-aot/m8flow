<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:spiffworkflow="http://spiffworkflow.org/bpmn/schema/1.0/core" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_it_incident" targetNamespace="http://bpmn.io/schema/bpmn" exporter="m8flow perf-seed builder" exporterVersion="1">
  <bpmn:collaboration id="Collaboration_it_incident">
    <bpmn:participant id="Participant_it_incident" name="IT Incident Management" processRef="it_incident" />
  </bpmn:collaboration>
  <bpmn:signal id="Signal_incident_resolved" name="incident_resolved" />
  <bpmn:process id="it_incident" name="IT Incident Management" isExecutable="true">
    <bpmn:documentation>ITIL-style incident management: DMN prioritisation, SLA reminders, change approval, a resolution signal and reporter confirmation.</bpmn:documentation>
    <bpmn:ioSpecification>
      <bpmn:dataInput id="incident_input" name="Incident channel" />
      <bpmn:dataOutput id="incident_outcome" name="Incident outcome" />
      <bpmn:inputSet><bpmn:dataInputRefs>incident_input</bpmn:dataInputRefs></bpmn:inputSet>
      <bpmn:outputSet><bpmn:dataOutputRefs>incident_outcome</bpmn:dataOutputRefs></bpmn:outputSet>
    </bpmn:ioSpecification>
    <bpmn:laneSet id="LaneSet_it_incident">
      <bpmn:lane id="Lane_submitters" name="Submitters">
        <bpmn:flowNodeRef>start_incident</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report_incident</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prioritize_incident</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_fanout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_await</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>catch_resolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timer_sla</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post_sla_breach</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_comms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm_resolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>close_incident</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_closed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_support" name="Support">
        <bpmn:flowNodeRef>diagnose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_sla_reminder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>remind_assignee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_reminded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_resolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>apply_workaround</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>implement_fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>throw_resolved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_approvers" name="Approvers">
        <bpmn:flowNodeRef>approve_change</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_change</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_incident" name="Incident reported">
      <bpmn:outgoing>Flow_start_incident_report_incident</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="report_incident" name="Report incident">
      <bpmn:extensionElements><spiffworkflow:properties><spiffworkflow:property name="formJsonSchemaFilename" value="incident-report-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="incident-report-uischema.json" /></spiffworkflow:properties><spiffworkflow:preScript>incident_input = 'self-service portal'</spiffworkflow:preScript></bpmn:extensionElements>
      <bpmn:incoming>Flow_start_incident_report_incident</bpmn:incoming>
      <bpmn:outgoing>Flow_report_incident_prioritize_incident</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:businessRuleTask id="prioritize_incident" name="Prioritise incident">
      <bpmn:extensionElements><spiffworkflow:calledDecisionId>incident_priority</spiffworkflow:calledDecisionId><spiffworkflow:postScript>sla_reminders = 0
sla_breached = False</spiffworkflow:postScript></bpmn:extensionElements>
      <bpmn:incoming>Flow_report_incident_prioritize_incident</bpmn:incoming>
      <bpmn:outgoing>Flow_prioritize_incident_gw_fanout</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:parallelGateway id="gw_fanout">
      <bpmn:incoming>Flow_prioritize_incident_gw_fanout</bpmn:incoming>
      <bpmn:outgoing>Flow_gw_fanout_gw_await</bpmn:outgoing>
      <bpmn:outgoing>Flow_gw_fanout_diagnose</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:eventBasedGateway id="gw_await" name="Resolved or SLA?">
      <bpmn:incoming>Flow_gw_fanout_gw_await</bpmn:incoming>
      <bpmn:outgoing>Flow_gw_await_catch_resolved</bpmn:outgoing>
      <bpmn:outgoing>Flow_gw_await_timer_sla</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="catch_resolved" name="Incident resolved">
      <bpmn:incoming>Flow_gw_await_catch_resolved</bpmn:incoming>
      <bpmn:outgoing>Flow_catch_resolved_gw_comms</bpmn:outgoing>
      <bpmn:signalEventDefinition signalRef="Signal_incident_resolved" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="timer_sla" name="SLA elapsed">
      <bpmn:incoming>Flow_gw_await_timer_sla</bpmn:incoming>
      <bpmn:outgoing>Flow_timer_sla_post_sla_breach</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">'PT' + str(sla_seconds) + 'S'</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:scriptTask id="post_sla_breach" name="Post SLA breach notice">
      <bpmn:incoming>Flow_timer_sla_post_sla_breach</bpmn:incoming>
      <bpmn:outgoing>Flow_post_sla_breach_gw_comms</bpmn:outgoing>
      <bpmn:script>sla_breached = True</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="gw_comms">
      <bpmn:incoming>Flow_catch_resolved_gw_comms</bpmn:incoming>
      <bpmn:incoming>Flow_post_sla_breach_gw_comms</bpmn:incoming>
      <bpmn:outgoing>Flow_gw_comms_gw_join</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="diagnose" name="Diagnose incident">
      <bpmn:extensionElements><spiffworkflow:properties><spiffworkflow:property name="formJsonSchemaFilename" value="diagnosis-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="diagnosis-uischema.json" /></spiffworkflow:properties><spiffworkflow:instructionsForEndUser>{{ priority }} incident on {{ service }}: {{ summary }} ({{ affected_users }} users).</spiffworkflow:instructionsForEndUser></bpmn:extensionElements>
      <bpmn:incoming>Flow_gw_fanout_diagnose</bpmn:incoming>
      <bpmn:outgoing>Flow_diagnose_gw_resolution</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="b_sla_reminder" name="Every 10 s" attachedToRef="diagnose" cancelActivity="false">
      <bpmn:outgoing>Flow_b_sla_reminder_remind_assignee</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">"R3/PT10S"</bpmn:timeCycle></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:scriptTask id="remind_assignee" name="Remind assignee">
      <bpmn:incoming>Flow_b_sla_reminder_remind_assignee</bpmn:incoming>
      <bpmn:outgoing>Flow_remind_assignee_end_reminded</bpmn:outgoing>
      <bpmn:script>sla_reminders += 1</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:endEvent id="end_reminded" name="Reminder sent">
      <bpmn:incoming>Flow_remind_assignee_end_reminded</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="gw_resolution" name="Resolution path?" default="Flow_gw_resolution_gw_fix">
      <bpmn:incoming>Flow_diagnose_gw_resolution</bpmn:incoming>
      <bpmn:outgoing>Flow_gw_resolution_approve_change</bpmn:outgoing>
      <bpmn:outgoing>Flow_gw_resolution_gw_fix</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="approve_change" name="Approve emergency change">
      <bpmn:extensionElements><spiffworkflow:properties><spiffworkflow:property name="formJsonSchemaFilename" value="change-approval-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="change-approval-uischema.json" /></spiffworkflow:properties></bpmn:extensionElements>
      <bpmn:incoming>Flow_gw_resolution_approve_change</bpmn:incoming>
      <bpmn:outgoing>Flow_approve_change_gw_change</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_change" name="Change approved?" default="Flow_gw_change_gw_fix">
      <bpmn:incoming>Flow_approve_change_gw_change</bpmn:incoming>
      <bpmn:outgoing>Flow_gw_change_apply_workaround</bpmn:outgoing>
      <bpmn:outgoing>Flow_gw_change_gw_fix</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="apply_workaround" name="Apply workaround">
      <bpmn:incoming>Flow_gw_change_apply_workaround</bpmn:incoming>
      <bpmn:outgoing>Flow_apply_workaround_gw_fix</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="gw_fix">
      <bpmn:incoming>Flow_gw_resolution_gw_fix</bpmn:incoming>
      <bpmn:incoming>Flow_gw_change_gw_fix</bpmn:incoming>
      <bpmn:incoming>Flow_apply_workaround_gw_fix</bpmn:incoming>
      <bpmn:outgoing>Flow_gw_fix_implement_fix</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="implement_fix" name="Implement fix">
      <bpmn:extensionElements><spiffworkflow:instructionsForEndUser>Implement the {{ resolution_type }} for {{ root_cause }}.</spiffworkflow:instructionsForEndUser></bpmn:extensionElements>
      <bpmn:incoming>Flow_gw_fix_implement_fix</bpmn:incoming>
      <bpmn:outgoing>Flow_implement_fix_throw_resolved</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:intermediateThrowEvent id="throw_resolved" name="Incident resolved">
      <bpmn:incoming>Flow_implement_fix_throw_resolved</bpmn:incoming>
      <bpmn:outgoing>Flow_throw_resolved_gw_join</bpmn:outgoing>
      <bpmn:signalEventDefinition signalRef="Signal_incident_resolved" />
    </bpmn:intermediateThrowEvent>
    <bpmn:parallelGateway id="gw_join">
      <bpmn:incoming>Flow_gw_comms_gw_join</bpmn:incoming>
      <bpmn:incoming>Flow_throw_resolved_gw_join</bpmn:incoming>
      <bpmn:outgoing>Flow_gw_join_confirm_resolution</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="confirm_resolution" name="Confirm resolution">
      <bpmn:extensionElements><spiffworkflow:properties><spiffworkflow:property name="formJsonSchemaFilename" value="resolution-confirmation-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="resolution-confirmation-uischema.json" /></spiffworkflow:properties></bpmn:extensionElements>
      <bpmn:incoming>Flow_gw_join_confirm_resolution</bpmn:incoming>
      <bpmn:outgoing>Flow_confirm_resolution_close_incident</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:scriptTask id="close_incident" name="Close incident">
      <bpmn:incoming>Flow_confirm_resolution_close_incident</bpmn:incoming>
      <bpmn:outgoing>Flow_close_incident_end_closed</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_close_incident_incident_record"><bpmn:targetRef>incident_record_ref</bpmn:targetRef></bpmn:dataOutputAssociation>
      <bpmn:script>incident_record = {'priority': priority, 'service': service, 'root_cause': root_cause, 'sla_breached': sla_breached}
incident_outcome = 'closed' if confirmed else 'closed_unconfirmed'</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:endEvent id="end_closed" name="Incident closed">
      <bpmn:incoming>Flow_close_incident_end_closed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObject id="incident_record" />
    <bpmn:dataObjectReference id="incident_record_ref" name="Incident record" dataObjectRef="incident_record" />
    <bpmn:sequenceFlow id="Flow_start_incident_report_incident" sourceRef="start_incident" targetRef="report_incident" />
    <bpmn:sequenceFlow id="Flow_report_incident_prioritize_incident" sourceRef="report_incident" targetRef="prioritize_incident" />
    <bpmn:sequenceFlow id="Flow_prioritize_incident_gw_fanout" sourceRef="prioritize_incident" targetRef="gw_fanout" />
    <bpmn:sequenceFlow id="Flow_gw_fanout_gw_await" sourceRef="gw_fanout" targetRef="gw_await" />
    <bpmn:sequenceFlow id="Flow_gw_fanout_diagnose" sourceRef="gw_fanout" targetRef="diagnose" />
    <bpmn:sequenceFlow id="Flow_gw_await_catch_resolved" sourceRef="gw_await" targetRef="catch_resolved" />
    <bpmn:sequenceFlow id="Flow_gw_await_timer_sla" sourceRef="gw_await" targetRef="timer_sla" />
    <bpmn:sequenceFlow id="Flow_catch_resolved_gw_comms" sourceRef="catch_resolved" targetRef="gw_comms" />
    <bpmn:sequenceFlow id="Flow_timer_sla_post_sla_breach" sourceRef="timer_sla" targetRef="post_sla_breach" />
    <bpmn:sequenceFlow id="Flow_post_sla_breach_gw_comms" sourceRef="post_sla_breach" targetRef="gw_comms" />
    <bpmn:sequenceFlow id="Flow_gw_comms_gw_join" sourceRef="gw_comms" targetRef="gw_join" />
    <bpmn:sequenceFlow id="Flow_b_sla_reminder_remind_assignee" sourceRef="b_sla_reminder" targetRef="remind_assignee" />
    <bpmn:sequenceFlow id="Flow_remind_assignee_end_reminded" sourceRef="remind_assignee" targetRef="end_reminded" />
    <bpmn:sequenceFlow id="Flow_diagnose_gw_resolution" sourceRef="diagnose" targetRef="gw_resolution" />
    <bpmn:sequenceFlow id="Flow_gw_resolution_approve_change" name="change" sourceRef="gw_resolution" targetRef="approve_change"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">resolution_type == 'change_required'</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_resolution_gw_fix" name="fix" sourceRef="gw_resolution" targetRef="gw_fix" />
    <bpmn:sequenceFlow id="Flow_approve_change_gw_change" sourceRef="approve_change" targetRef="gw_change" />
    <bpmn:sequenceFlow id="Flow_gw_change_apply_workaround" name="rejected" sourceRef="gw_change" targetRef="apply_workaround"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">outcome == 'reject'</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_change_gw_fix" name="approved" sourceRef="gw_change" targetRef="gw_fix" />
    <bpmn:sequenceFlow id="Flow_apply_workaround_gw_fix" sourceRef="apply_workaround" targetRef="gw_fix" />
    <bpmn:sequenceFlow id="Flow_gw_fix_implement_fix" sourceRef="gw_fix" targetRef="implement_fix" />
    <bpmn:sequenceFlow id="Flow_implement_fix_throw_resolved" sourceRef="implement_fix" targetRef="throw_resolved" />
    <bpmn:sequenceFlow id="Flow_throw_resolved_gw_join" sourceRef="throw_resolved" targetRef="gw_join" />
    <bpmn:sequenceFlow id="Flow_gw_join_confirm_resolution" sourceRef="gw_join" targetRef="confirm_resolution" />
    <bpmn:sequenceFlow id="Flow_confirm_resolution_close_incident" sourceRef="confirm_resolution" targetRef="close_incident" />
    <bpmn:sequenceFlow id="Flow_close_incident_end_closed" sourceRef="close_incident" targetRef="end_closed" />
    <bpmn:textAnnotation id="note_signal"><bpmn:text>Resolution throws incident_resolved; the reporter's event gateway catches it unless the SLA timer fires first</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_note_signal" sourceRef="throw_resolved" targetRef="note_signal" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_it_incident">
    <bpmndi:BPMNPlane id="BPMNPlane_it_incident" bpmnElement="Collaboration_it_incident">
      <bpmndi:BPMNShape id="Participant_it_incident_di" bpmnElement="Participant_it_incident" isHorizontal="true"><dc:Bounds x="120" y="60" width="2800" height="780" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_submitters_di" bpmnElement="Lane_submitters" isHorizontal="true"><dc:Bounds x="150" y="60" width="2770" height="260" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_support_di" bpmnElement="Lane_support" isHorizontal="true"><dc:Bounds x="150" y="320" width="2770" height="390" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_approvers_di" bpmnElement="Lane_approvers" isHorizontal="true"><dc:Bounds x="150" y="710" width="2770" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_incident_di" bpmnElement="start_incident"><dc:Bounds x="247" y="107" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="217" y="147" width="96" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="report_incident_di" bpmnElement="report_incident"><dc:Bounds x="385" y="85" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="prioritize_incident_di" bpmnElement="prioritize_incident"><dc:Bounds x="555" y="85" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_fanout_di" bpmnElement="gw_fanout"><dc:Bounds x="750" y="100" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_await_di" bpmnElement="gw_await"><dc:Bounds x="920" y="100" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="890" y="154" width="110" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="catch_resolved_di" bpmnElement="catch_resolved"><dc:Bounds x="1097" y="107" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1067" y="147" width="96" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="timer_sla_di" bpmnElement="timer_sla"><dc:Bounds x="1097" y="237" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1067" y="277" width="96" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="post_sla_breach_di" bpmnElement="post_sla_breach"><dc:Bounds x="1235" y="215" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_comms_di" bpmnElement="gw_comms"><dc:Bounds x="1430" y="100" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="diagnose_di" bpmnElement="diagnose"><dc:Bounds x="895" y="345" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="remind_assignee_di" bpmnElement="remind_assignee"><dc:Bounds x="895" y="475" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_reminded_di" bpmnElement="end_reminded"><dc:Bounds x="1097" y="497" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1067" y="537" width="96" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_resolution_di" bpmnElement="gw_resolution"><dc:Bounds x="1090" y="360" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1060" y="414" width="110" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="approve_change_di" bpmnElement="approve_change"><dc:Bounds x="1235" y="735" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_change_di" bpmnElement="gw_change"><dc:Bounds x="1430" y="750" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1400" y="804" width="110" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="apply_workaround_di" bpmnElement="apply_workaround"><dc:Bounds x="1575" y="605" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_fix_di" bpmnElement="gw_fix"><dc:Bounds x="1770" y="360" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="implement_fix_di" bpmnElement="implement_fix"><dc:Bounds x="1915" y="345" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="throw_resolved_di" bpmnElement="throw_resolved"><dc:Bounds x="2117" y="367" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2087" y="407" width="96" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_join_di" bpmnElement="gw_join"><dc:Bounds x="2280" y="100" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="confirm_resolution_di" bpmnElement="confirm_resolution"><dc:Bounds x="2425" y="85" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="close_incident_di" bpmnElement="close_incident"><dc:Bounds x="2595" y="85" width="100" height="80" /></bpmndi:BPMNShape>
