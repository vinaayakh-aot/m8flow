<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:spiffworkflow="http://spiffworkflow.org/bpmn/schema/1.0/core" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_db-heartbeat" targetNamespace="http://bpmn.io/schema/bpmn" exporter="m8flow perf-seed builder" exporterVersion="1">
  <bpmn:collaboration id="Collaboration_db-heartbeat">
    <bpmn:participant id="Participant_db-heartbeat" name="Database Heartbeat" processRef="db-heartbeat" />
  </bpmn:collaboration>
  <bpmn:process id="db-heartbeat" name="Database Heartbeat" isExecutable="true">
    <bpmn:documentation>Scheduled health probe: every minute, run SELECT 1 through the postgres connector.</bpmn:documentation>
    <bpmn:startEvent id="start_heartbeat" name="Every minute">
      <bpmn:outgoing>Flow_start_heartbeat_probe_db</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">"R/PT1M"</bpmn:timeCycle></bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="probe_db" name="Probe database">
      <bpmn:extensionElements><spiffworkflow:serviceTaskOperator id="postgres_v2/DoSQL" resultVariable="probe_result"><spiffworkflow:parameters><spiffworkflow:parameter id="m8flow_profile" type="any" value='"default"' /><spiffworkflow:parameter id="database_connection_str" type="any" /><spiffworkflow:parameter id="schema" type="any" value="{'sql': 'SELECT 1, now()::text', 'fetch_results': True}" /></spiffworkflow:parameters></spiffworkflow:serviceTaskOperator><spiffworkflow:postScript>db_ok = probe_result['command_response']['http_status'] == 200</spiffworkflow:postScript></bpmn:extensionElements>
      <bpmn:incoming>Flow_start_heartbeat_probe_db</bpmn:incoming>
      <bpmn:outgoing>Flow_probe_db_end_heartbeat</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_heartbeat" name="Probe done">
      <bpmn:incoming>Flow_probe_db_end_heartbeat</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_start_heartbeat_probe_db" sourceRef="start_heartbeat" targetRef="probe_db" />
    <bpmn:sequenceFlow id="Flow_probe_db_end_heartbeat" sourceRef="probe_db" targetRef="end_heartbeat" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_db-heartbeat">
    <bpmndi:BPMNPlane id="BPMNPlane_db-heartbeat" bpmnElement="Collaboration_db-heartbeat">
      <bpmndi:BPMNShape id="Participant_db-heartbeat_di" bpmnElement="Participant_db-heartbeat" isHorizontal="true"><dc:Bounds x="120" y="60" width="590" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_heartbeat_di" bpmnElement="start_heartbeat"><dc:Bounds x="247" y="107" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="217" y="147" width="96" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="probe_db_di" bpmnElement="probe_db"><dc:Bounds x="385" y="85" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_heartbeat_di" bpmnElement="end_heartbeat"><dc:Bounds x="587" y="107" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="557" y="147" width="96" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_start_heartbeat_probe_db_di" bpmnElement="Flow_start_heartbeat_probe_db"><di:waypoint x="283" y="125" /><di:waypoint x="385" y="125" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_probe_db_end_heartbeat_di" bpmnElement="Flow_probe_db_end_heartbeat"><di:waypoint x="485" y="125" /><di:waypoint x="587" y="125" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
