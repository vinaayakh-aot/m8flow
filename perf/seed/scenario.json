      ]
    },
    {
      "template": "purchase-requisition",
      "group": "procurement",
      "id": "marketing-services-requisitions",
      "display_name": "Marketing Services Requisitions",
      "paths": [
        "manager-approved software",
        "manager-rejected marketing"
      ]
    },
    {
      "template": "employee-onboarding",
      "group": "human-resources",
      "id": "engineering-onboarding",
      "display_name": "Engineering Onboarding",
      "paths": [
