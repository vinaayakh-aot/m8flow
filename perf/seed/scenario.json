      ]
    },
    {
      "template": "employee-onboarding",
      "group": "human-resources",
      "id": "sales-onboarding",
      "display_name": "Sales Onboarding",
      "paths": [
        "sales laptop backorder"
      ]
    },
    {
      "template": "employee-onboarding",
      "group": "human-resources",
      "id": "contractor-onboarding",
